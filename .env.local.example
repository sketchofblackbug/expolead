# Public site URL used in QR codes (no trailing slash)
# Falls back to window.location.origin if unset
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser (required for WhatsApp status updates + webhook)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Cloud API (Meta) — server-only, never NEXT_PUBLIC_*
WHATSAPP_TOKEN=your-permanent-or-temp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=your_approved_template_name
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-string
