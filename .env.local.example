# Public site URL used in QR codes (no trailing slash)
# Falls back to window.location.origin if unset
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser (optional; for admin/API routes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
